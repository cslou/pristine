{
  "name": "@pristine/shield-local",
  "version": "0.0.1",
  "description": "Local-first privacy and source-pointer memory SDK — no server; no user data leaves by default",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlou-gh/pristine.git"
  },
  "bugs": {
    "url": "https://github.com/getlou-gh/pristine/issues"
  },
  "homepage": "https://github.com/getlou-gh/pristine#readme",
  "keywords": [
    "local-first",
    "privacy",
    "memory",
    "semantic-search",
    "sqlite",
    "sqlite-vec",
    "embeddings",
    "typescript",
    "sdk"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ --no-error-on-unmatched-pattern",
    "test": "npm run test:unit && npm run test:smoke && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --passWithNoTests --config vitest.unit.config.ts",
    "test:smoke": "npm run build && vitest run --passWithNoTests --config vitest.smoke.config.ts",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts",
    "test:e2e": "vitest run --passWithNoTests --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "db:reset": "rm -f ~/.pristine/data/pristine.db*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.1.0",
    "@typescript-eslint/eslint-plugin": "8.26.1",
    "@typescript-eslint/parser": "8.26.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.5.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@huggingface/transformers": "4.0.1",
    "better-sqlite3": "12.8.0",
    "sqlite-vec": "0.1.9"
  }
}
